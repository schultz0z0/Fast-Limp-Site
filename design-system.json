  "layout": {
    "coordinateSystem": "CSS pixels; reference image pixels are not equal to rendered CSSpx",
    "containerRule": "width: min(1200px, calc(100% - 2 * responsive-gutter)); centered",
    "wideContainerRule": "width: min(1320px, calc(100% - 2 * responsive-gutter)); centered",
    "breakpoints": {
      "small": 640,
      "medium": 768,
      "large": 1024,
      "xlarge": 1280,
      "wide": 1600
    },
    "gridColumns": {
      "mobile": 4,
      "tablet": 8,
      "desktop": 12
    },
    "responsiveGutters": {
      "below768": 20,
      "from768": 32,
      "from1024": 40
    },
    "sectionPaddingBlock": {
      "mobile": 56,
      "tablet": 72,
      "desktop": 96
    },
    "textMeasure": "52-65ch for body; hero title~12-16ch; avoid hardcoded linebreaks on mobile",
    "referenceApproximation": true,
    "outerFrame": {
      "demoBackdrop": false,
      "waterTexture": false,
      "headerTopRadiusDesktop": 20,
      "mainPageMaxWidth": false
    },
    "overlapPolicy": "Only intentional composition: hero card, about collage, photo badge, team nameplates. Use separate decorative clipped background, preserve content/focus and document flow."
  },
