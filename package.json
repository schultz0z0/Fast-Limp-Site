{
  "name": "fast-limp-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "check:production": "node scripts/check.mjs --production",
    "test:content": "node scripts/test-content.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test": "node scripts/test-interactions.mjs"
  },
  "engines": { "node": ">=20" }
}
